    {
      "id": 13,
      "title": "Errores HTTP backend (% de respuestas)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(backend_http_requests_total{status=~\"5..\"}[1m])) / clamp_min(sum(rate(backend_http_requests_total[1m])), 0.000001)",
          "legendFormat": "errores 5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
