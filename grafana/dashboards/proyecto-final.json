        {
          "refId": "A",
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_network_receive_bytes_total{job=\"cadvisor\",container_label_monitoring_group=\"proyecto-final\",image!=\"\"}[1m]))",
